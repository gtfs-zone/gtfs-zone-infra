{
  "realm": "gtfs",
  "displayName": "GTFS.Zone",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "verifyEmail": false,

  "clients": [
    {
      "clientId": "oauth2-proxy",
      "name": "oauth2-proxy",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${KC_OAUTH2_PROXY_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://auth.gtfs.zone/oauth2/callback",
        "https://dagster.gtfs.zone/oauth2/callback"
      ],
      "webOrigins": ["https://auth.gtfs.zone", "https://dagster.gtfs.zone"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "acr",
        "basic",
        "email",
        "profile",
        "roles",
        "web-origins",
        "groups"
      ],
      "protocolMappers": [
        {
          "name": "identity provider",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "consentRequired": false,
          "config": {
            "user.session.note": "identity_provider",
            "claim.name": "identity_provider",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "traccar",
      "name": "Traccar",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${KC_TRACCAR_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["https://traccar.gtfs.zone/*"],
      "webOrigins": ["https://traccar.gtfs.zone"],
      "defaultClientScopes": [
        "acr",
        "basic",
        "email",
        "profile",
        "roles",
        "web-origins",
        "groups"
      ]
    },
    {
      "clientId": "rt-api",
      "name": "rt-api (admin API reader)",
      "description": "Service account the admin app uses to read which upstream providers are linked to a realm account. Read-only: view-users and nothing else.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${KC_RT_API_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "argocd",
      "name": "Argo CD",
      "description": "argocd.gtfs.zone. ArgoCD speaks OIDC directly (its bundled Dex is disabled) so it gets a real subject and the groups claim its RBAC keys on.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${KC_ARGOCD_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://argocd.gtfs.zone/auth/callback",
        "https://argocd.kcfam.us/auth/callback",
        "http://localhost:8085/auth/callback"
      ],
      "webOrigins": ["https://argocd.gtfs.zone", "https://argocd.kcfam.us"],
      "defaultClientScopes": [
        "acr",
        "basic",
        "email",
        "profile",
        "roles",
        "web-origins",
        "groups"
      ]
    }
  ],

  "clientScopes": [
    {
      "name": "groups",
      "description": "Realm group memberships, as a flat `groups` claim.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],

  "groups": [
    {
      "name": "argocd-admins",
      "path": "/argocd-admins"
    },
    {
      "name": "gtfs-admins",
      "path": "/gtfs-admins"
    },
    {
      "name": "keycloak-admins",
      "path": "/keycloak-admins",
      "clientRoles": {
        "realm-management": ["realm-admin"]
      }
    }
  ],

  "users": [
    {
      "username": "service-account-rt-api",
      "enabled": true,
      "serviceAccountClientId": "rt-api",
      "clientRoles": {
        "realm-management": ["view-users"]
      }
    }
  ],

  "identityProviders": [
    {
      "alias": "github",
      "displayName": "GitHub",
      "providerId": "github",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "linkOnly": false,
      "addReadTokenRoleOnCreate": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "${KC_GITHUB_CLIENT_ID}",
        "clientSecret": "${KC_GITHUB_CLIENT_SECRET}",
        "defaultScope": "read:user user:email",
        "syncMode": "IMPORT"
      }
    },
    {
      "alias": "google",
      "displayName": "Google",
      "providerId": "google",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "linkOnly": false,
      "addReadTokenRoleOnCreate": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "${KC_GOOGLE_CLIENT_ID}",
        "clientSecret": "${KC_GOOGLE_CLIENT_SECRET}",
        "defaultScope": "openid email profile",
        "syncMode": "IMPORT"
      }
    },
    {
      "alias": "gitlab",
      "displayName": "GitLab",
      "providerId": "gitlab",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "linkOnly": false,
      "addReadTokenRoleOnCreate": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "${KC_GITLAB_CLIENT_ID}",
        "clientSecret": "${KC_GITLAB_CLIENT_SECRET}",
        "defaultScope": "read_user openid email",
        "syncMode": "IMPORT"
      }
    }
  ]
}
